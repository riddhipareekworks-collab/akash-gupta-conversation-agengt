# Copy to an ignored local env file. Never commit real credentials.
# postgres keeps the current Neon connection; supabase selects SUPABASE_DB_URL.
DATABASE_PROVIDER=postgres
DATABASE_URL=
# Supabase Connect > Session pooler (port 5432), PostgreSQL URI with DB password.
# No publishable/anon/service-role API key is needed for this server connection.
SUPABASE_DB_URL=
# Optional Supabase root certificate PEM; use literal \n for line breaks.
DATABASE_SSL_CA=
# Same-session context: 12-200 messages, 8000-120000 characters.
CHAT_CONTEXT_MESSAGES=80
CHAT_CONTEXT_CHARACTERS=48000
CHAT_MEMORY_SEARCH=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_ORIGIN=http://localhost:3000
ADMIN_OWNER_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional: team signs in as "team" with this password, without admin access.
TEAM_PASSWORD=
# No image-storage subscription needed; uploads are stored in PostgreSQL (Neon or Supabase).
ASSET_STORAGE=postgres
# Optional future alternative, only used when ASSET_STORAGE=r2.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
