# Copy to an ignored local env file. Never commit real credentials.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_ORIGIN=http://localhost:3000
ADMIN_OWNER_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
SITE_ACCESS=private
# Optional: team signs in as "team" with this password, without admin access.
TEAM_PASSWORD=
# No image-storage subscription needed; uploads are stored in Neon.
ASSET_STORAGE=postgres
# Optional future alternative, only used when ASSET_STORAGE=r2.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
